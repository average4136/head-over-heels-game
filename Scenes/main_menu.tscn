[sub_resource type="GDScript" id="GDScript_n45e2"]
script/source = "extends Control

func _on_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Scenes/Cutscenes/opening_cutscene.tscn\")

func _on_check_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Scenes/settings.tscn\")



func _ready():
	update_leaderboard()


func update_leaderboard():
	if not has_node(\"LeaderboardContainer/NamesContainer\"):
		return
	var entries = $LeaderboardContainer/NamesContainer.get_children()

	for i in range(5):
		var panel = entries[i + 1]
		var label = panel.get_child(0)

		if i < Leaderboard.scores.size():
			var score = Leaderboard.scores[i]

			label.text = \"%d. %s    %.2f seconds\" % [
				i + 1,
				score[\"name\"],
				score[\"time\"]
			]
		else:
			label.text = \"%d. ---\" % (i + 1)


func _on_settings_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Scenes/leaderboard_container.tscn\")
"

